# Puerto del servidor backend
PORT=5000

# Google Maps JavaScript API Key (Opcional)
# Si no se proporciona una clave, el sistema utiliza de forma automática
# y 100% funcional el visor Satelital Esri y OpenStreetMap sin requerir tarjetas ni cuotas.
VITE_GOOGLE_MAPS_API_KEY=

# Modo de entorno
NODE_ENV=development
